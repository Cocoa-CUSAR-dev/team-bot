# Copy to .env (gitignored) and fill in real values.

# Postgres -- SQLAlchemy async needs the asyncpg driver in the URL, not
# the plain postgresql:// scheme. Recommend a small, separate Neon DB
# (same provider the rest of this project already uses) rather than
# SQLite -- if this runs on Render, its default disk is ephemeral and
# would wipe a SQLite file on every deploy/restart.
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?ssl=require

# Discord Developer Portal > your application > Bot > Token
DISCORD_BOT_TOKEN=

# Right-click the target channel in Discord (Developer Mode on) > Copy Channel ID
DISCORD_CHANNEL_ID=

# Set the same value here as in each repo's Settings > Webhooks > Secret
GITHUB_WEBHOOK_SECRET=

WEBHOOK_PORT=8090
