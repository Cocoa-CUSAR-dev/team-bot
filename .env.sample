# Copy to .env (gitignored) and fill in real values.

# Postgres -- SQLAlchemy async needs the asyncpg driver in the URL, not
# the plain postgresql:// scheme. Recommend a small, separate Neon DB
# (same provider the rest of this project already uses) rather than
# SQLite -- if this runs on Render, its default disk is ephemeral and
# would wipe a SQLite file on every deploy/restart.
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?ssl=require

# Discord channel > Integrations > Webhooks > create one, paste the URL.
# Treat this as a secret -- anyone with it can post to that channel.
DISCORD_WEBHOOK_URL=

# Set the same value here as in each repo's Settings > Webhooks > Secret
GITHUB_WEBHOOK_SECRET=

# Guards POST /internal/daily-reminder -- pick any random string, then set
# the same value as REVIEW_BOT_INTERNAL_SECRET in the team-bot repo's GitHub
# Actions secrets (see .github/workflows/daily-reminder.yml).
INTERNAL_TRIGGER_SECRET=

# --- /myreviews slash command ------------------------------------------
# All optional: leave blank and everything else still works, the command
# just returns 503 until it's configured.

# Discord Developer Portal > your app > General Information > Public Key.
# The only one the deployed service needs -- it verifies interactions
# really came from Discord.
DISCORD_PUBLIC_KEY=

# The three below are used ONLY by `python -m src.register_commands`.
# Application ID: same General Information page.
DISCORD_APP_ID=
# Bot > Reset Token. Needed only to REGISTER the command -- the service
# never opens a gateway connection, so it never uses this at runtime.
DISCORD_BOT_TOKEN=
# Right-click the server in Discord (Developer Mode on) > Copy Server ID.
DISCORD_GUILD_ID=

WEBHOOK_PORT=8090
